# CloakCal environment template. Copy to .env.local and fill in.
# .env* is gitignored except this file. Never commit real keys.

# --- Supabase -----------------------------------------------------------------
# Project ref is not a secret (it appears in the API URL). Keys are.
NEXT_PUBLIC_SUPABASE_URL=https://bnjbgjzbddypqtoolunz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS entirely — never expose to the client, never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Development flags --------------------------------------------------------
# Allows a seeded mock session so prototyping and E2E never hit a login wall.
# Refused at build time when NODE_ENV=production.
CLOAKCAL_DEV_MOCK_SESSION=0

# Set to 1 from M3 onward. Rejects the `plaintext-v0` null codec, so development
# placeholder content can never be written by a real deployment.
CLOAKCAL_REQUIRE_REAL_CRYPTO=0
