# CloakCal environment template. Copy to apps/web/.env.local and fill in.
# .env* is gitignored except this file. Never commit real keys.
#
# On a machine that has the Vercel CLI linked, `vercel env pull apps/web/.env.local` is
# faster — but read the file afterwards. Any variable typed "Sensitive" on Vercel pulls as
# the literal string [SENSITIVE] while the command still prints ✓ and exits 0.

# --- Supabase -----------------------------------------------------------------
# Both of these are PUBLIC by design and safe in a client bundle. The publishable key
# identifies the project and authorises nothing; RLS is what authorises, and it is enforced
# in Postgres. See docs/deploy.md.
NEXT_PUBLIC_SUPABASE_URL=https://bnjbgjzbddypqtoolunz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# THERE IS NO SERVICE-ROLE KEY, AND THERE MUST NEVER BE ONE.
#
# This file used to list `SUPABASE_SECRET_KEY` with the comment "Bypasses RLS entirely".
# Nothing read it — a grep of apps/web/src finds only the four variables on this page — but a
# template that names the key is how one eventually gets pasted in, and rule 4 exists because
# a service-role key would make every RLS test in packages/db a test of an approximation
# rather than of the production path. Every read and write runs as the signed-in user.
#
# Two other variables were removed at the same time for the ordinary reason that no code has
# ever read them: CLOAKCAL_DEV_MOCK_SESSION and CLOAKCAL_REQUIRE_REAL_CRYPTO.

# --- Development ---------------------------------------------------------------
# Governs THREE things together, and they must not be separated: serving the committed
# fixture, unlocking it with the published seed key, and bypassing the auth middleware. All
# three also check NODE_ENV !== 'production', which Next inlines at build time, so a
# production bundle cannot reach any of them.
#
# Run the app with no account at all:  NEXT_PUBLIC_CLOAKCAL_DEV_UNLOCK=1 pnpm dev
#
# Never set this on Vercel. It would be refused by a production build anyway; setting it
# would be a sign that someone misunderstood what it does.
NEXT_PUBLIC_CLOAKCAL_DEV_UNLOCK=0

# --- Optional ------------------------------------------------------------------
# Absolute origin used to resolve the social card URL in metadata. Unset, the app falls back
# to Vercel's VERCEL_PROJECT_PRODUCTION_URL, then to http://localhost:3000.
# NEXT_PUBLIC_SITE_ORIGIN=https://cloakcal.com
