# Copy to .env.email-setup AT THE REPO ROOT (not here). That path is gitignored.
#
#   cp tools/email-setup.env.example .env.email-setup
#
# This template is deliberately NOT named .env.something: the repo gitignores `.env*`,
# which would silently swallow the template too — and, worse, would make a file full of
# real keys look tracked-and-safe when it is merely invisible. A filename that cannot be
# mistaken for the real thing is the point.

# --- Porkbun ----------------------------------------------------------------
# porkbun.com -> Account -> API Access -> create an API key.
#
# THEN, SEPARATELY: porkbun.com -> Domain Management -> cloakcal.com -> toggle
# "API ACCESS" on. It is off by default, PER DOMAIN, and the key alone will not work
# without it. This is the single most common reason the script fails at preflight.
PORKBUN_API_KEY=pk1_...
PORKBUN_SECRET_KEY=sk1_...

# --- Resend -----------------------------------------------------------------
# resend.com/api-keys — needs full access, because it creates a domain and mints the
# scoped sending key. Do not reuse this one in the app.
RESEND_API_KEY=re_...

# --- Supabase ---------------------------------------------------------------
# supabase.com/dashboard/account/tokens — a PERSONAL ACCESS TOKEN, prefix `sbp_`.
# Not the anon key, not the service-role key. Those cannot reach the Management API.
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_PROJECT_REF=bnjbgjzbddypqtoolunz

# --- Project ----------------------------------------------------------------
EMAIL_DOMAIN=cloakcal.com
EMAIL_SENDER_NAME=CloakCal
EMAIL_SENDER_ADDRESS=no-reply@cloakcal.com

# Where confirmation links land. Must be the origin users actually visit, or the link
# bounces them to localhost.
SITE_URL=https://cloakcal.com

# Optional. If set, the sending key is pushed to this Vercel project's env.
# VERCEL_PROJECT=cloakcal
